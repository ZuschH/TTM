{
  "product": {
    "contact_name": "",
    "contact_url": ""
  },
  "recording": {
    "reference": ""
  },
  "condition_monitoring": {
    "rules": []
  },
  "ups_shutdown": {
    "enabled": false,
    "dry_run": true,
    "input_voltage_threshold_v": 4.5,
    "input_loss_delay_seconds": 30,
    "watchdog_handoff_seconds": 15
  },
  "serial": {
    "device": "/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_B001YLYP-if00-port0",
    "baudrate": 19200,
    "parity": "E",
    "stopbits": 1,
    "bytesize": 8,
    "timeout_seconds": 0.75
  },
  "serial_buses": [
    {
      "id": "bus1",
      "device": "/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_B001YLYP-if00-port0",
      "baudrate": 19200,
      "parity": "E",
      "stopbits": 1,
      "bytesize": 8,
      "timeout_seconds": 0.75
    }
  ],
  "inverters": [
    {
      "name": "VFAS1-4037PL",
      "model": "VF-AS1",
      "bus_id": "bus1",
      "slave_id": 1,
      "enabled": true,
      "channels": {}
    }
  ],
  "polling": {
    "interval_seconds": 1.0,
    "intervals": {
      "fast": 0.2,
      "normal": 0.5,
      "diagnostic": 5.0,
      "information": 3600.0
    },
    "retries": 2,
    "retry_delay_seconds": 0.15,
    "reconnect_delay_seconds": 2.0
  },
  "communication_bridge": {
    "enabled": false,
    "mode": "transparent_proxy",
    "response_timeout_seconds": 0.75,
    "idle_read_timeout_seconds": 0.1,
    "scheduled_polling": {
      "enabled": false,
      "passive_decode": true,
      "idle_guard_seconds": 0.02,
      "response_timeout_seconds": 0.1,
      "minimum_gap_seconds": 0.02
    },
    "hmi_port": {"device": "", "baudrate": 19200, "parity": "E", "stopbits": 1},
    "drive_port": {"device": "", "baudrate": 19200, "parity": "E", "stopbits": 1}
  },
  "addons": [
    {
      "id": "pi_gpio",
      "type": "raspberry_pi_gpio",
      "label": "Raspberry Pi digital inputs",
      "stack": 0,
      "interval_seconds": 0.05,
      "enabled": false,
      "channels": [
        {"channel": 17, "label": "GPIO 17", "pull": "down", "active_low": false, "enabled": false, "live": false, "record": false},
        {"channel": 27, "label": "GPIO 27", "pull": "up", "active_low": true, "enabled": false, "live": false, "record": false}
      ]
    },
    {
      "id": "system_ups",
      "type": "sequent_super_watchdog",
      "label": "System UPS & watchdog",
      "interval_seconds": 1.0,
      "input_loss_threshold_v": 4.5,
      "battery_shutdown_voltage_v": 3.05,
      "battery_full_voltage_v": 4.15,
      "enabled": false,
      "channels": [
        {"metric": "input_voltage", "enabled": false, "live": false, "record": false},
        {"metric": "raspberry_voltage", "enabled": false, "live": false, "record": false},
        {"metric": "battery_voltage", "enabled": false, "live": false, "record": false},
        {"metric": "board_temperature", "enabled": false, "live": false, "record": false},
        {"metric": "charge_status", "enabled": false, "live": false, "record": false},
        {"metric": "reset_count", "enabled": false, "live": false, "record": false}
      ]
    },
    {
      "id": "system_fan",
      "type": "sequent_smart_fan",
      "label": "System cooling",
      "stack": 0,
      "interval_seconds": 2.0,
      "enabled": false,
      "control": {
        "mode": "monitor",
        "minimum_power_percent": 25,
        "start_temperature_c": 45,
        "full_temperature_c": 70,
        "manual_power_percent": 25,
        "failsafe_power_percent": 100
      },
      "channels": [
        {"metric": "fan_power", "enabled": false, "live": false, "record": false},
        {"metric": "stop_interval", "enabled": false, "live": false, "record": false},
        {"metric": "processor_temperature", "enabled": false, "live": false, "record": false},
        {"metric": "target_power", "enabled": false, "live": false, "record": false}
      ]
    },
    {
      "id": "field_di",
      "type": "sequent_16inpind",
      "label": "External digital inputs",
      "stack": 0,
      "interval_seconds": 0.02,
      "enabled": false,
      "channels": [
        {"channel": 1, "label": "Safety circuit", "enabled": false, "live": false, "record": false},
        {"channel": 2, "label": "Machine ready", "enabled": false, "live": false, "record": false}
      ]
    },
    {
      "id": "field_ai",
      "type": "sequent_24b8vin",
      "label": "External analog inputs",
      "stack": 1,
      "interval_seconds": 0.05,
      "enabled": false,
      "channels": [
        {"channel": 1, "label": "Hydraulic pressure", "gain": 1, "scale": 25.0, "offset": 0.0, "unit": "bar", "decimals": 2, "enabled": false, "live": false, "record": false}
      ]
    },
    {
      "id": "field_multiio",
      "type": "sequent_multiio",
      "label": "External Multi-IO",
      "stack": 2,
      "interval_seconds": 0.05,
      "enabled": false,
      "channels": [
        {"signal": "digital", "channel": 1, "label": "Safety circuit", "enabled": false, "live": false, "record": false},
        {"signal": "voltage", "channel": 1, "label": "Position signal", "scale": 1.0, "offset": 0.0, "unit": "V", "enabled": false, "live": false, "record": false},
        {"signal": "current", "channel": 1, "label": "Pressure transmitter", "scale": 1.0, "offset": 0.0, "unit": "mA", "enabled": false, "live": false, "record": false},
        {"signal": "temperature", "channel": 1, "label": "Bearing temperature", "unit": "°C", "enabled": false, "live": false, "record": false}
      ]
    }
  ],
  "storage": {
    "database": "/var/lib/tmm/measurements.sqlite3",
    "retention_days": 365,
    "cleanup_interval_seconds": 3600,
    "export_max_rows": 250000,
    "parameter_write_max_backup_age_minutes": 60,
    "change_logging": {
      "enabled": true,
      "initial_snapshot_on_start": true,
      "communication_unreachable_after_transport_errors": 3,
      "default_analog_delta": 0.1,
      "successful_cycle_interval_seconds": 60.0,
      "thresholds": {
        "output_frequency": 0.05,
        "frequency_setpoint": 0.05,
        "output_current": 0.1,
        "dc_input_voltage": 0.1,
        "output_voltage": 0.1,
        "braking_resistor_load": 1.0,
        "fm_analog_output": 0.5,
        "inverter_internal_temperature": 1.0,
        "power_board_temperature": 1.0,
        "speed_feedback": 0.05,
        "speed_feedback_filtered": 0.05,
        "torque": 0.1,
        "torque_command": 0.1,
        "torque_current": 0.1,
        "exciting_current": 0.1,
        "motor_overload_factor": 0.1,
        "inverter_overload_factor": 0.1,
        "motor_load_factor": 1.0,
        "inverter_load_factor": 1.0,
        "input_power": 0.01,
        "output_power": 0.01,
        "calculated_motor_speed": 1.0,
        "machine_speed": 1.0,
        "actual_output_current": 0.1,
        "actual_output_voltage": 1.0,
        "actual_motor_torque": 0.1,
        "mechanical_power": 0.01
      }
    }
  },
  "alerts": {
    "system": {
      "cpu_percent": {"warning": 80, "critical": 95},
      "temperature_celsius": {"warning": 70, "critical": 80},
      "memory_percent": {"warning": 85, "critical": 95},
      "disk_percent": {"warning": 85, "critical": 95}
    },
    "metrics": {
      "output_current": {"warning": 90, "critical": 110},
      "dc_input_voltage": {"warning": 110, "critical": 120},
      "braking_resistor_load": {"warning": 70, "critical": 90},
      "inverter_internal_temperature": {"warning": 70, "critical": 85},
      "power_board_temperature": {"warning": 80, "critical": 95}
    }
  },
  "web": {
    "host": "0.0.0.0",
    "port": 8080,
    "stale_after_seconds": 10,
    "allow_remote_administration": false
  }
}
