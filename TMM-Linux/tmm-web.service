[Unit]
Description=Toshiba Modbus Monitor (TMM) V1.0 web interface
After=network.target tmm.service
Wants=tmm.service

[Service]
Type=simple
User=tmm
Group=tmm
WorkingDirectory=/opt/tmm
ExecStart=/opt/tmm/.venv/bin/python /opt/tmm/tmm_web.py --config /etc/tmm/config.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tmm
ReadWritePaths=-/mnt/tmm-data

[Install]
WantedBy=multi-user.target
